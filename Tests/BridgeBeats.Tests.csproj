<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RepositoryUrl>https://github.com/tsmarvin/BridgeBeats</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.2" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.Redis" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\BridgeBeats.AppHost\BridgeBeats.AppHost.csproj">
      <!--
        Only used for Aspire distributed testing. ExcludeAssets prevents conflicts
        with WebApplicationFactory-based tests that use BridgeBeats.Web.Program.
        The AppHost is only loaded explicitly via DistributedApplicationTestingBuilder.
      -->
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\src\BridgeBeats.Contracts\BridgeBeats.Contracts.csproj" />
    <ProjectReference Include="..\src\BridgeBeats.Web\BridgeBeats.Web.csproj" />
    <ProjectReference Include="..\src\BridgeBeats.Worker.Discord\BridgeBeats.Worker.Discord.csproj" />
    <ProjectReference Include="..\src\BridgeBeats.Worker.SagaCoordinator\BridgeBeats.Worker.SagaCoordinator.csproj" />
    <ProjectReference Include="..\src\BridgeBeats.Worker.JetStreamWatcher\BridgeBeats.Worker.JetStreamWatcher.csproj" />
    <ProjectReference Include="..\src\BridgeBeats.Worker.Spotify\BridgeBeats.Worker.Spotify.csproj" />
    <ProjectReference Include="..\src\BridgeBeats.Worker.Maintenance\BridgeBeats.Worker.Maintenance.csproj" />
  </ItemGroup>

</Project>
