# Dockerfile for Caddy with Cloudflare DNS plugin
# This image is built with the Cloudflare DNS module for ACME DNS-01 challenges
# Required for wildcard certificate support (*.domain.com)

FROM caddy:2.11.7-builder@sha256:c4cd20eaa0b69112fd5d4f721ffc9671687e1d5d0b155c8620cf7546dbef94c0 AS builder

# Build Caddy with Cloudflare DNS plugin
RUN xcaddy build v2.11.7 --with github.com/caddy-dns/cloudflare@v0.2.4

FROM caddy:2.11.7@sha256:36c24ad91a7ff7bc4c87fe22bfa8df3c4b18da0773d73fc12ee2c52b98c0bb7e

# Copy custom Caddy binary with Cloudflare plugin
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# Verify the binary works
RUN caddy version

# Default ports
EXPOSE 80 443

# Default command
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
