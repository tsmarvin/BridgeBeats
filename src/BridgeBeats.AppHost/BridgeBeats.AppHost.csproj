<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>bridgebeats-apphost</UserSecretsId>
    <RepositoryUrl>https://github.com/tsmarvin/BridgeBeats</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BridgeBeats.Contracts\BridgeBeats.Contracts.csproj" IsAspireProjectResource="false" />
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.2" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.2" />
    <PackageReference Include="MessagePack" Version="3.1.8" />

    <ProjectReference Include="..\BridgeBeats.Web\BridgeBeats.Web.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Discord\BridgeBeats.Worker.Discord.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Spotify\BridgeBeats.Worker.Spotify.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.AppleMusic\BridgeBeats.Worker.AppleMusic.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Tidal\BridgeBeats.Worker.Tidal.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.SagaCoordinator\BridgeBeats.Worker.SagaCoordinator.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.JetStreamWatcher\BridgeBeats.Worker.JetStreamWatcher.csproj" />
    <ProjectReference Include="..\BridgeBeats.Worker.Maintenance\BridgeBeats.Worker.Maintenance.csproj" />
  </ItemGroup>
</Project>
