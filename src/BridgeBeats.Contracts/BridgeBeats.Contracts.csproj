<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RepositoryUrl>https://github.com/tsmarvin/BridgeBeats</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Shared package dependency for ATProto records - provides AtProtoRecord base class -->
  <ItemGroup>
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
    <PackageReference Include="idunno.AtProto" Version="8.0.0" />
    <PackageReference Include="idunno.Bluesky" Version="8.0.0" />
    <!-- idunno.AtProto 8.0.0 pulls Microsoft.AspNetCore.WebUtilities 10.0.0 transitively,
         which is affected by GHSA-x33c-w48q-qrgc (CVE-2026-114149, high severity DoS).
         Direct reference lifts it to the patched 10.0.15 release. -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BridgeBeats.Web" />
    <InternalsVisibleTo Include="BridgeBeats.Core" />
    <InternalsVisibleTo Include="BridgeBeats.Tests" />
  </ItemGroup>

</Project>
