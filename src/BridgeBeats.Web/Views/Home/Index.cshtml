@{
ViewData["Title"] = "Music Lookup";
var cspNonce = Context.Items["CSPNonce"] as string ?? string.Empty;
}

<div class="card mb-4">
  <div class="card-body">

    <div class="d-flex justify-content-between align-items-start mb-3">
      <h2 class="card-title mb-0">Music Lookup</h2>
      <button class="btn btn-outline-secondary btn-sm rounded-circle btn-help-icon" type="button" data-bs-toggle="collapse"
        data-bs-target="#howItWorksContent" aria-expanded="false" aria-controls="howItWorksContent"
        title="How It Works">
        <strong>?</strong>
      </button>
    </div>

    <!-- How It Works (Collapsible) -->
    <div id="howItWorksContent" class="collapse collapse-with-transition mb-4">
      <div class="alert alert-info">
        <h6 class="alert-heading">How It Works</h6>
        <ol class="mb-0 ps-3">
          <li><strong>Extract</strong> - We identify the track or album from your link.</li>
          <li><strong>Match</strong> - Using ISRC/UPC codes or metadata, we find equivalent links for the
            other platforms.</li>
          <li><strong>Share</strong> - Use the share button to send a link to the song or album from all of
            the available music services.</li>
        </ol>
      </div>
    </div>

    <fieldset class="mb-4">
      <p class="text-muted mb-4">
        Share music effortlessly. Paste a track or album link from Apple Music, Spotify, or Tidal, and get
        matching links for the song or album; so everyone can listen, no matter where they stream.
      </p>
      <div class="d-flex gap-3 flex-wrap">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="mode" id="urlRadio" value="url" checked />
          <label class="form-check-label" for="urlRadio">
            <strong>URL</strong>
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="mode" id="titleRadio" value="title" />
          <label class="form-check-label" for="titleRadio">
            <strong>Title Search</strong>
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="mode" id="isrcRadio" value="isrc" />
          <label class="form-check-label" for="isrcRadio">
            <strong>ISRC</strong>
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="mode" id="upcRadio" value="upc" />
          <label class="form-check-label" for="upcRadio">
            <strong>UPC</strong>
          </label>
        </div>
      </div>
    </fieldset>

    <div id="inputs" class="mb-3">
      <div id="protectedModeOverlay" class="protected-mode-overlay d-none">
        <div class="overlay-content">
          <p class="mb-0">
            <a href="/account/login">Login</a> to use this feature. Rate limits apply.
          </p>
        </div>
      </div>
      <form id="lookupForm" asp-controller="Home" asp-action="LookupResults" method="post">
        <!-- URL Mode -->
        <div id="urlRow" class="mb-3">
          <label for="url" class="form-label">
            <strong>Enter Track or Album Url</strong>
          </label>
          <p class="text-muted mb-4">Paste a link to a track or album from Apple Music, Spotify, or Tidal.</p>
          <input id="url" name="uri" type="text" class="form-control form-control-lg" placeholder="" />
          <div class="form-text">
            <strong>Examples:</strong><br />
            <span id="urlExamples"></span>
          </div>
        </div>

        <!-- ISRC Mode -->
        <div id="isrcRow" class="mb-3 d-none">
          <label for="isrc" class="form-label">
            <strong>Enter ISRC Code</strong>
          </label>
          <p class="text-muted mb-4">
            ISRC (International Standard Recording Code) uniquely identifies sound
            recordings.
          </p>
          <input id="isrc" type="text" class="form-control" placeholder="" />
          <div class="form-text">
            <strong>Format:</strong> 12 characters<br />
            <strong>Examples:</strong><br />
            <span id="isrcExamples"></span><br />
          </div>
        </div>

        <!-- UPC Mode -->
        <div id="upcRow" class="mb-3 d-none">
          <label for="upc" class="form-label">
            <strong>Enter UPC Code</strong>
          </label>
          <p class="text-muted mb-4">UPC (Universal Product Code) identifies albums and releases.</p>
          <input id="upc" type="text" class="form-control" placeholder="" />
          <div class="form-text">
            <strong>Format:</strong> 12-14 digits<br />
            <strong>Examples:</strong><br />
            <span id="upcExamples"></span><br />
          </div>
        </div>

        <!-- Title/Artist Mode -->
        <div id="titleRow" class="mb-3 d-none">
          <label class="form-label">
            <strong>Enter Title/Artist</strong>
          </label>
          <p class="text-muted mb-4">Search by song/album Title and Artist name</p>
          <div class="row g-2">
            <div class="col-12 col-md-6">
              <label for="title" class="form-label">Title</label>
              <input id="title" type="text" class="form-control" placeholder="" />
            </div>
            <div class="col-12 col-md-6">
              <label for="artist" class="form-label">Artist</label>
              <input id="artist" type="text" class="form-control" placeholder="" />
            </div>
          </div>
          <div class="form-text">
            <strong>Tips:</strong> Use the primary artist name and the complete name of the track or
            album.<br />
            <strong>Examples:</strong><br />
            <span id="titleExamples"></span>
          </div>
        </div>

        <div class="d-flex gap-2 align-items-center">
          <button id="go" type="submit" class="btn btn-primary btn-lg">
            Search
          </button>
          <span id="status" class="text-muted"></span>
        </div>
      </form>
    </div>

    <div id="resultsSection" class="d-none">
      <hr class="my-4" />
      <h3 class="mb-3">Results</h3>
      <div id="resultContainer">
        <pre id="result" class="bg-body-secondary p-3 rounded d-none" aria-live="polite">{}</pre>
        <div id="cardsContainer"></div>
      </div>
    </div>
  </div>
</div>


<!-- Features Section -->
<div class="container-xxl px-0">
  <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Accurate Matching</h5>
          <p class="card-text">
            Uses ISRC (tracks) and UPC (albums) for precise cross-service matching.
          </p>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Discord Bot</h5>
          <p class="card-text">
            Automatically converts music links in your Discord server.<br />
            Share a Spotify link and get the Apple Music and Tidal links too!<br />
            Add the <a href="https://discord.com/oauth2/authorize?client_id=1417324891161759815">Discord Bot</a>
            to your server today!<br />
            See the <a href="https://docs.bridgebeats.link/DISCORD_SETTINGS.html">Discord settings guide</a>
            to configure its channel permissions.
          </p>
        </div>
      </div>
    </div>
    <div class="col">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">Are You A Developer?</h5>
          <p class="card-text">
            <a href="/account/register">Register</a> an account to get access to the RESTful API
            and start integrating BridgeBeats lookups into your app today!<br />
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

