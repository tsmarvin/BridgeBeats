        },
        {
          title: 'No Captain (feat. POLIÇA)',
          artist: 'Lane 8',
          trackLink: 'https://tidal.com/browse/track/128587876',
          isrc: 'FRX201711788',
          albumLink: 'https://tidal.com/album/128587874',
          upc: '5039060467091'
        }
      ]
    };

    // Get one random example from each provider
    function getOneFromEachProvider() {
      const apple = examplesByProvider.appleMusic[Math.floor(Math.random() * examplesByProvider.appleMusic.length)];
      const spotify = examplesByProvider.spotify[Math.floor(Math.random() * examplesByProvider.spotify.length)];
      const tidal = examplesByProvider.tidal[Math.floor(Math.random() * examplesByProvider.tidal.length)];

      // Shuffle the three to randomize which one is shown as placeholder
      const all = [apple, spotify, tidal];
      for (let i = all.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [all[i], all[j]] = [all[j], all[i]];
      }

      return all;
    }

    // Initialize examples on page load
    function initializeExamples() {
      const [placeholder, example1, example2] = getOneFromEachProvider();

      // URL placeholder and examples - one from each provider
      $('url').placeholder = placeholder.albumLink;
      $('urlExamples').innerHTML = `• <code>${example1.trackLink}</code><br/>• <code>${example2.trackLink}</code>`;

      // ISRC placeholder and examples - use all three
      $('isrc').placeholder = placeholder.isrc;
      $('isrcExamples').innerHTML = `• <code>${example1.isrc}</code>,<br/>• <code>${example2.isrc}</code>`;

      // UPC placeholder and examples - use all three
      $('upc').placeholder = placeholder.upc;
      $('upcExamples').innerHTML = `• <code>${example1.upc}</code>,<br/>• <code>${example2.upc}</code>`;

      // Title/Artist placeholders and examples - use all three
      $('title').placeholder = placeholder.title;
      $('artist').placeholder = placeholder.artist;
      $('titleExamples').innerHTML = `• <strong>${example1.title}</strong> by ${example1.artist},<br/>• <strong>${example2.title}</strong> by ${example2.artist}`;
    }

    // Initialize examples
    initializeExamples();

    // Check auth status to enable/disable protected modes
    fetch('/account/status', { credentials: 'same-origin' })
      .then(res => res.json())
      .then(data => { isAuthenticated = data.isAuthenticated; updateUI(); })
      .catch(() => { isAuthenticated = false; updateUI(); });

    function updateUI() {
      // Show/hide overlay based on auth status and current mode
      const currentMode = (modeRadios.find(r => r.checked) || {}).value;
      const showOverlay = !isAuthenticated && protectedModes.includes(currentMode);
      protectedModeOverlay.classList.toggle(HIDDEN_CLASS, !showOverlay);
    }

    function setMode(mode) {
      urlRow.classList.toggle(HIDDEN_CLASS, mode !== 'url');
      isrcRow.classList.toggle(HIDDEN_CLASS, mode !== 'isrc');
      upcRow.classList.toggle(HIDDEN_CLASS, mode !== 'upc');
      titleRow.classList.toggle(HIDDEN_CLASS, mode !== 'title');
      updateUI();
    }

    modeRadios.forEach(r => r.addEventListener('change', (e) => setMode(e.target.value)));
    setMode('url');

    // Handle form submission for all modes with server-side rendering
    lookupForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Close keyboard on mobile devices
      document.activeElement?.blur();

      const mode = (modeRadios.find(r => r.checked) || {}).value;
      const status = $('status');
      const result = $('result');
      const cardsContainer = $('cardsContainer');
      const resultsSection = $('resultsSection');

      // If protected mode and not authenticated, don't submit
      if (!isAuthenticated && protectedModes.includes(mode)) {
        return;
      }

      // Clear previous results
      result.textContent = '{}';
      result.classList.add('d-none');
      cardsContainer.innerHTML = '';

      // Show working status
      status.textContent = 'Searching across platforms...';
      lookupForm.querySelector('button[type="submit"]').disabled = true;

      try {
        let endpoint = '';
        const formData = new FormData(lookupForm);

        switch (mode) {
          case 'url':
            endpoint = '/Home/LookupResultsStream';
            const urlValue = $('url').value.trim();
            if (!urlValue) {
              throw new Error('Please enter a music link');
            }
            formData.append('uri', urlValue);
            break;
          case 'isrc':
            endpoint = '/Home/LookupResultsByIsrc';
            const isrcValue = $('isrc').value.trim();
            if (!isrcValue) {
              throw new Error('Please enter an ISRC code');
            }
            formData.append('isrc', isrcValue);
            break;
          case 'upc':
            endpoint = '/Home/LookupResultsByUpc';
            const upcValue = $('upc').value.trim();
            if (!upcValue) {
              throw new Error('Please enter a UPC code');
            }
            formData.append('upc', upcValue);
            break;
          case 'title':
            endpoint = '/Home/LookupResultsByTitle';
            const titleValue = $('title').value.trim();
            const artistValue = $('artist').value.trim();
            if (!titleValue || !artistValue) {
              throw new Error('Please enter both title and artist');
            }
            formData.append('title', titleValue);
            formData.append('artist', artistValue);
            break;
        }

        const res = await safeFetch(endpoint, {
          method: 'POST',
          body: formData,
          credentials: 'same-origin'
        });

        // Show results section
        resultsSection.classList.remove('d-none');

        if (res.ok) {
          // For streaming URL endpoint, process the stream
          if (mode === 'url') {
            // Prepare grid container for streaming results
            cardsContainer.innerHTML = '<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3"></div>';
            const gridContainer = cardsContainer.querySelector('.row');

            const reader = res.body.getReader();
            const decoder = new TextDecoder();
            const streamItemDelimiter = document.documentElement.dataset.streamItemDelimiter;
            if (!streamItemDelimiter) throw new Error('Streaming protocol configuration is missing');
            let buffer = '';
            let cardCount = 0;
            let streamCompleted = false;

            while (true) {
              const { done, value } = await reader.read();

              if (value) {
                buffer += decoder.decode(value, { stream: !done });

                // Process only explicitly framed server items. HTTP chunks may end at any nested
                // closing div, so treating a chunk boundary as a card boundary truncates cards.
                let lastDelimiter = buffer.lastIndexOf(streamItemDelimiter);
                if (lastDelimiter !== -1) {
                  const completeHTML = buffer.substring(0, lastDelimiter);
                  buffer = buffer.substring(lastDelimiter + streamItemDelimiter.length);

                  // Check for completion marker
                  const tempDiv = document.createElement('div');
                  tempDiv.innerHTML = completeHTML;
                  const completionMarker = tempDiv.querySelector('[data-stream-complete="true"]');

                  if (completionMarker) {
                    streamCompleted = true;
                    const processed = parseInt(completionMarker.getAttribute('data-processed') || '0');
                    const errors = parseInt(completionMarker.getAttribute('data-errors') || '0');
                    const rateLimited = parseInt(completionMarker.getAttribute('data-rate-limited') || '0');

                    // Remove the completion marker from HTML
                    completionMarker.remove();

                    // Add remaining cards if any
                    if (tempDiv.children.length > 0) {
                      for (const child of Array.from(tempDiv.children)) {
                        if (child.classList.contains('col')) {
                          gridContainer.appendChild(child);
                          cardCount++;
                        } else {
                          cardsContainer.appendChild(child);
                        }
                      }
                    }

                    // Update summary
                    if (cardCount > 0) {
                      let message = `Found ${cardCount} result${cardCount > 1 ? 's' : ''}`;
                      if (errors > 0) {
                        message += ` (${errors} could not be matched)`;
                      }
                      if (rateLimited > 0) {
                        message += ` \u2014 ${rateLimited} track${rateLimited > 1 ? 's were' : ' was'} rate-limited and will be retried`;
                      }
                      status.textContent = message;

                      // Initialize share buttons
                      if (typeof initializeShareButtons === 'function') {
                        setTimeout(initializeShareButtons, 100);
                      }
                    } else if (rateLimited > 0) {
                      status.textContent = 'Some providers are temporarily rate-limited. Please try again in a moment.';
                      cardsContainer.innerHTML = `
                        <div class="alert alert-warning">
                          <strong>Rate Limited</strong><br/>
                          One or more music providers are temporarily rate-limited. Please try again shortly.
                        </div>`;
                    } else {
                      status.textContent = 'No matches found';
                      cardsContainer.innerHTML = `
                        <div class="alert alert-warning">
                          <strong>No matches found</strong><br/>
                          Try a different search or check that the link is valid and the content is available in your region.
                        </div>`;
                    }

                    break;
                  } else {
                    // Add cards to grid
                    for (const child of Array.from(tempDiv.children)) {
                      if (child.classList.contains('col')) {
                        gridContainer.appendChild(child);
                        cardCount++;

                        // Update progress
                        status.textContent = `Found ${cardCount} result${cardCount > 1 ? 's' : ''}...`;
                      } else if (child.classList.contains('alert')) {
                        cardsContainer.appendChild(child);
                      }
                    }

                    // Initialize share buttons for newly added cards
                    if (typeof initializeShareButtons === 'function') {
                      initializeShareButtons();
                    }
                  }
                }
              }

              if (done) {
                break;
              }
            }
            if (!streamCompleted) {
              throw new Error('The lookup stream ended before its completion frame.');
            }
          } else {
            // For non-streaming endpoints (ISRC, UPC, Title), use the existing approach
            const html = await res.text();
            cardsContainer.innerHTML = html;

            // Initialize share buttons for dynamically loaded content
            if (typeof initializeShareButtons === 'function') {
              setTimeout(initializeShareButtons, 100);
            }

            // Count results
            const resultCards = cardsContainer.querySelectorAll('.embed-card');
            if (resultCards.length > 0) {
              status.textContent = `Found ${resultCards.length} result${resultCards.length > 1 ? 's' : ''}`;
            } else {
              status.textContent = 'No matches found';
              cardsContainer.innerHTML = `
                <div class="alert alert-warning">
                  <strong>No matches found</strong><br/>
                  Try a different search or check that the link is valid and the content is available in your region.
                </div>`;
            }
          }
        } else if (res.status === 401) {
          result.textContent = JSON.stringify({
            error: 'Authentication required',
            message: 'Please login to access this endpoint.'
          }, null, 2);
          result.classList.remove('d-none');
          status.textContent = 'Login required';
        } else if (res.status === 429) {
          const data = await res.json().catch(() => ({
            error: 'Rate limit exceeded',
            message: 'Too many requests. Please try again later.'
          }));
          result.textContent = JSON.stringify(data, null, 2);
          result.classList.remove('d-none');
          status.textContent = 'Rate limit exceeded';
        } else if (res.status === 400) {
          const data = await res.json().catch(() => ({
            error: 'Invalid request',
            message: 'Please check your input and try again.'
          }));
          result.textContent = JSON.stringify(data, null, 2);
          result.classList.remove('d-none');
          status.textContent = 'Invalid input';
        } else {
          const data = await res.json().catch(() => ({
            error: `HTTP ${res.status}`,
            message: 'The lookup request failed.'
          }));
          result.textContent = JSON.stringify(data, null, 2);
          result.classList.remove('d-none');
          status.textContent = data.message || `Error (HTTP ${res.status})`;
        }
      } catch (err) {
        resultsSection.classList.remove('d-none');
        status.textContent = 'Error';
        result.textContent = JSON.stringify({ error: String(err.message || err) }, null, 2);
        result.classList.remove('d-none');
      } finally {
        lookupForm.querySelector('button[type="submit"]').disabled = false;
      }
    });
  })();
</script>
}
