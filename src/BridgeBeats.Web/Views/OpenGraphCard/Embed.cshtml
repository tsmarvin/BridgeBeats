@using BridgeBeats.Contracts.Enums
@using Microsoft.AspNetCore.Html
@{
    Layout = null;
    var result = Model.Result as BridgeBeats.Contracts.DTOs.MediaLinkResult;
    var primaryProvider = (SupportedProviders)Model.PrimaryProvider;
    var primaryResult = Model.PrimaryResult as BridgeBeats.Contracts.DTOs.MusicLookupResult;
    var cardUrl = Model.CardUrl as string;
    var atProtoUri = Model.ATProtoUri as string;
    var qrCodeDataUri = Model.QrCodeDataUri as string;
    var providerClass = $"provider-{primaryProvider.ToString().ToLowerInvariant()}";

    // Use QR code data URI if provided, otherwise use artwork URL
    var imageUrl = !string.IsNullOrWhiteSpace(qrCodeDataUri) ? qrCodeDataUri : primaryResult?.ArtUrl;

    // Get CSP nonce from HttpContext
    var cspNonce = Context.Items["CSPNonce"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(primaryResult?.Title ?? "Music Card")</title>
    <link rel="stylesheet" href="~/public/docfx.min.css">
    <link rel="stylesheet" href="~/public/main.css">
    <link rel="stylesheet" href="~/public/BridgeBeats.styles.css">

    <script nonce="@cspNonce">
        (function () {
            const root = document.documentElement;
            root.removeAttribute('data-bs-theme'); // Remove any existing theme attr to avoid stale state
            root.setAttribute('data-bs-theme', window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        })();
    </script>
    <style nonce="@cspNonce">
        body {
            margin: 0;
            padding: 0;
            background: transparent;
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
            overflow: hidden;
        }

        /* Ensure card fits perfectly in iframe with no extra space */
        .embed-card {
            max-width: 100%;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="embed-card @providerClass">
        <div class="embed-header-top">
            <div class="embed-title-row">
                @if (!string.IsNullOrWhiteSpace(cardUrl)) {
                    <a href="@cardUrl" target="_blank" rel="noopener noreferrer" class="embed-title">
                        @(primaryResult?.Title ?? "Unknown Title")
                    </a>
                } else {
                    <div class="embed-title">@(primaryResult?.Title ?? "Unknown Title")</div>
                }
            </div>
        </div>
        <div class="embed-header">
            @if (!string.IsNullOrWhiteSpace(imageUrl)) {
                @if (!string.IsNullOrWhiteSpace(cardUrl)) {
                    <a href="@cardUrl" target="_blank" rel="noopener noreferrer">
                        <img src="@imageUrl" alt="@primaryResult?.Title artwork" class="embed-image" />
                    </a>
                } else {
                    <img src="@imageUrl" alt="@primaryResult?.Title artwork" class="embed-image" />
                }
            }
            <div class="embed-content">
                <div class="embed-info">
                    Artist: @(primaryResult?.Artist ?? "Unknown")
                    @if (!string.IsNullOrWhiteSpace(primaryResult?.ExternalId)) {
                        var idType = primaryResult.IsAlbum == true ? "UPC" : "ISRC";
                        <text><br /></text>@idType<text>: </text>@primaryResult.ExternalId
                    }
                </div>
            </div>
        </div>
        <div class="embed-providers">
            @if (result != null) {
                foreach (var providerResult in result.Results) {
                    <a href="@(ViewSecurityHelpers.IsHttpOrHttps(providerResult.Value.URL) ? providerResult.Value.URL : "#")" target="_blank" rel="noopener noreferrer" class="provider-button">
                        <span class="provider-icon provider-icon-@providerResult.Key.ToString().ToLowerInvariant()">
                            @providerResult.Key.GetProviderLogo( )
                        </span>
                        <span class="visually-hidden">@providerResult.Key.GetDescription()</span>
                    </a>
                }
            }
        </div>
    </div>
</body>
</html>
