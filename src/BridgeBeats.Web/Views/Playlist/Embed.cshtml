@model BridgeBeats.Web.Models.PlaylistViewModel
@using BridgeBeats.Contracts.Enums
@{
    Layout = null;

    // Get CSP nonce from HttpContext
    var cspNonce = Context.Items["CSPNonce"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@Model.Title</title>

    <script nonce="@cspNonce">
        (function () {
            const root = document.documentElement;
            root.removeAttribute('data-bs-theme'); // Remove any existing theme attr to avoid stale state
            root.setAttribute('data-bs-theme', window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        })();
    </script>

    <style nonce="@cspNonce">
        :root {
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.35;
            font-size: 13px;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: transparent;
        }

        /* Screen-reader only */
        .visually-hidden {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0 0 0 0) !important;
            clip-path: inset(50%) !important;
            border: 0 !important;
            white-space: nowrap !important;
        }

        .playlist-embed {
            background: var(--bs-body-bg, #fff);
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(0, 0, 0, .10);
            width: 100%;
            display: flex;
            flex-direction: column;
            color: var(--bs-body-color, #111827);
            overflow: hidden;
        }

        /* Header (56px) */
        .embed-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            height: 56px;
            padding: 0 .95rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            box-sizing: border-box;
        }

            .embed-header h2 {
                margin: 0;
                font-size: 16px;
                font-weight: 600;
                line-height: 1.15;
            }

            .embed-header p {
                margin: .25rem 0 0 0;
                font-size: 13px;
                opacity: .95;
                font-weight: 500;
                line-height: 1;
            }

        /* Scrollable items */
        .embed-items {
            flex: 1 1 auto;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #d1d5db transparent;
        }

        .embed-items-webkit-scrollbar {
            width: 6px;
        }

        .embed-items-webkit-scrollbar-track {
            background: transparent;
        }

        .embed-items::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 3px;
        }

        /* Row (74px) */
        .embed-item {
            display: grid;
            grid-template-columns: 52px 1fr auto;
            gap: .6rem .85rem;
            align-items: center;
            height: 74px;
            padding: 0 .95rem;
            box-sizing: border-box;
            border-bottom: 1px solid var(--bs-border-color, #e5e7eb);
        }

            .embed-item:last-child {
                border-bottom: none;
            }

            .embed-item:hover {
                background: var(--bs-tertiary-bg, #f9fafb);
            }

        .item-artwork-small {
            width: 52px;
            height: 52px;
            border-radius: 6px;
            object-fit: cover;
            display: block;
            background: #e5e7eb;
        }

        .item-info-compact {
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .item-title-compact {
            font-weight: 600;
            margin: 0 0 .25rem 0;
            color: var(--bs-emphasis-color, #111827);
            line-height: 1.2;
            text-decoration: none;
            word-break: break-word;
            letter-spacing: .15px;
        }

            .item-title-compact:hover {
                color: #667eea;
            }

        .item-artist-compact {
            color: var(--bs-secondary-color, #374151);
            margin: 0;
            line-height: 1.1;
            word-break: break-word;
            font-weight: 500;
        }

        /* Providers */
        .item-providers {
            display: flex;
            gap: .45rem;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
        }

        .provider-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: .35rem .5rem;
            background: var(--bs-secondary-bg, #f3f4f6);
            border: 1px solid var(--bs-border-color, #e5e7eb);
            border-radius: 8px;
            height: 32px;
            min-width: 36px;
            text-decoration: none;
            transition: background .15s, box-shadow .15s;
        }

            .provider-button:hover {
                background: var(--bs-tertiary-bg, #e0e2e7);
                box-shadow: 0 2px 4px rgba(0, 0, 0, .08);
            }

        /* Icons */
        .provider-icon-light,
        .provider-icon-dark {
            height: 18px;
            width: auto;
            display: block;
            object-fit: contain;
            margin: 0;
        }

        .provider-icon-dark {
            display: none;
        }

        html[data-bs-theme="dark"] .provider-icon-light {
            display: none;
        }

        html[data-bs-theme="dark"] .provider-icon-dark {
            display: block;
        }

        @@media (prefers-color-scheme: dark) {

            html[data-bs-theme="auto"] .provider-icon-light,
            html:not([data-bs-theme]) .provider-icon-light {
                display: none;
            }

            html[data-bs-theme="auto"] .provider-icon-dark,
            html:not([data-bs-theme]) .provider-icon-dark {
                display: block;
            }
        }

        /* Footer (48px) - match header gradient */
        .embed-footer {
            height: 48px;
            padding: 0 .95rem;
            box-sizing: border-box;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            border-top: none;
            color: #fff;
            font-size: 13px;
        }

        .view-full-link {
            color: #fff;
            font-weight: 500;
            text-decoration: none;
            opacity: .95;
            letter-spacing: .15px;
        }

            .view-full-link:hover {
                text-decoration: underline;
                opacity: 1;
            }

        /* Dark mode footer tweak (slightly brighter link) */
        html[data-bs-theme="dark"] .embed-footer {
            background: linear-gradient(135deg, #5d6fe5 0%, #8052b5 100%);
        }

        /* Dark mode */
        html[data-bs-theme="dark"] .playlist-embed {
            background: #1f2329;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .35);
        }

        html[data-bs-theme="dark"] .embed-item {
            border-bottom-color: #2f343b;
        }

            html[data-bs-theme="dark"] .embed-item:hover {
                background: #262b31;
            }

        html[data-bs-theme="dark"] .item-title-compact {
            color: #f1f5f9;
        }

        html[data-bs-theme="dark"] .item-artist-compact {
            color: #cbd5e1;
        }

        html[data-bs-theme="dark"] .provider-button {
            background: #2a3036;
            border-color: #394047;
            color: #e5e7eb;
        }

            html[data-bs-theme="dark"] .provider-button:hover {
                background: #333941;
            }

        html[data-bs-theme="dark"] .embed-footer {
            border-top-color: #2f343b;
        }

        html[data-bs-theme="dark"] .view-full-link:hover {
            color: #b0c1ff;
        }

        /* Mobile */
        @@media (max-width:430px) {
            .embed-item {
                grid-template-columns: 48px 1fr;
            }

            .item-providers {
                justify-content: flex-start;
                margin-top: .35rem;
            }

            .provider-button {
                min-width: 32px;
            }
        }
    </style>
</head>
<body>
    <div class="playlist-embed">
        <div class="embed-header">
            <h2>@Model.Title</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Description)) {
                <p>@Model.Description</p>
            } else {
                <p>@Model.Items.Count @(Model.Items.Count == 1 ? "item" : "items")</p>
            }
        </div>
        <div class="embed-items">
            @foreach (var item in Model.Items) {
                var imageUrl = !string.IsNullOrWhiteSpace(Model.QrCodeDataUri) ? Model.QrCodeDataUri : item.ArtUrl;
                <div class="embed-item">
                    @if (!string.IsNullOrWhiteSpace(imageUrl)) {
                        <a href="@item.CardUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@imageUrl" alt="@item.Title artwork" class="item-artwork-small" />
                        </a>
                    }
                    <div class="item-info-compact">
                        <a href="@item.CardUrl" target="_blank" rel="noopener noreferrer" class="item-title-compact">@item.Title</a>
                        <div class="item-artist-compact">@item.Artist</div>
                    </div>
                    <div class="item-providers">
                        @if (item.Result?.Results != null) {
                            foreach (var provider in item.Result.Results.Keys.OrderBy(k => k)) {
                                var providerResult = item.Result.Results[provider];
                                <a href="@(ViewSecurityHelpers.IsHttpOrHttps(providerResult.URL) ? providerResult.URL : "#")"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="provider-button provider-@provider.ToString().ToLowerInvariant()"
                                   title="@provider.GetDescription()">
                                    @provider.GetProviderIcon()
                                    <span class="visually-hidden">@provider.GetDescription()</span>
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
        <div class="embed-footer">
            <a href="https://@Model.Domain/playlist/@Model.PlaylistId"
               target="_blank"
               rel="noopener noreferrer"
               class="view-full-link">View Full Playlist →</a>
        </div>
    </div>
</body>
</html>
