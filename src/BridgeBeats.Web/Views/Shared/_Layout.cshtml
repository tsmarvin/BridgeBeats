@{
    var title = ViewData["Title"] as string ?? string.Empty;
    // Get CSP nonce from HttpContext
    var cspNonce = Context.Items["CSPNonce"] as string ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-stream-item-delimiter="@BridgeBeats.Web.Streaming.StreamFraming.ItemDelimiter">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - BridgeBeats</title>
    <link rel="stylesheet" href="~/public/docfx.min.css">
    <link rel="stylesheet" href="~/public/main.css">
    <link rel="stylesheet" href="~/public/BridgeBeats.styles.css">
    <meta name="loc:themeLight" content="Light">
    <meta name="loc:themeDark" content="Dark">
    <meta name="loc:themeAuto" content="Auto">
    <meta name="loc:changeTheme" content="Change theme">
    <script type="module" src="~/public/docfx.min.js"></script>
    <script src="~/public/antiforgery.js"></script>
    <script src="~/public/share-buttons.js"></script>
    <script nonce="@cspNonce">
        // FOUC mitigation: Apply theme before page render
        // NOTE: This logic must stay synchronized with docfx.min.js theme management
        // If theme logic in docfx.min.js changes, update this inline script accordingly
        const theme = localStorage.getItem('theme') || 'auto'
        document.documentElement.setAttribute('data-bs-theme', theme === 'auto' ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme)
    </script>
    <script src="~/public/playlist-manager.js"></script>
</head>

<body class="tex2jax_ignore" data-layout="">
    @await Html.PartialAsync("_Header")

    <main class="container-xxl mt-3">
        <div class="content">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-body border-top mt-3">
        <div class="container-xxl">
            <div class="footer-content px-3 py-1">
                <div class="footer-left">
                    <span class="footer-separator">|</span>
                    <span>&copy;2025 Taylor Marvin</span>
                    <span class="footer-separator">|</span>
                    <a href="/Home/Privacy">Privacy</a>
                    <span class="footer-separator">|</span>
                    <a href="/Home/Tos">Terms of Service</a>
                    <span class="footer-separator">|</span>
                </div>
                <div class="footer-right text-muted">
                    BridgeBeats is not affiliated with or endorsed by Apple Music, Spotify, or Tidal. <br />
                    Apple Music, Spotify, and Tidal are trademarks of their respective owners.
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
