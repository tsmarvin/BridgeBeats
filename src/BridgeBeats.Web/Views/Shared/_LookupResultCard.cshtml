@model BridgeBeats.Web.Models.MusicLookupViewModel.MusicLookupResultItem
@using BridgeBeats.Core.Infrastructure.Storage
@using BridgeBeats.Contracts.Enums
@using Microsoft.AspNetCore.Html

@{
    // Generate rkey for this card
    var rkey = RecordKeyGenerator.GenerateRkey(Model.Result);
    // Use provider enum value as a class for styling
    var providerClass = $"provider-{Model.PrimaryProvider.ToString().ToLowerInvariant()}";
}

<div class="col">
    <div class="embed-card h-100 @providerClass" data-rkey="@rkey">
        <div class="embed-header-top">
            <div class="embed-title-row">
                @if (!string.IsNullOrWhiteSpace(Model.CardUrl)) {
                    <a href="@Model.CardUrl" target="_blank" rel="noopener noreferrer" class="embed-title">
                        @(Model.PrimaryResult.Title ?? "Unknown Title")
                    </a>
                } else {
                    <div class="embed-title">@(Model.PrimaryResult.Title ?? "Unknown Title")</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CardUrl)) {
                    <div class="share-dropdown">
                        <button class="share-button" type="button" aria-expanded="false" aria-haspopup="true" title="Share">
                            <img src="/public/Share_arrow.png" alt="Share" class="share-arrow-icon" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button class="dropdown-item copy-link-btn" type="button" data-url="@Model.CardUrl">
                                    <span class="dropdown-icon">📋</span> Copy Link
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item copy-embed-btn" type="button" data-url="@Model.CardUrl" data-title='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PrimaryResult.Title ?? "Music Link", ViewSecurityHelpers.HtmlSafeJsonOptions))'>
                                    <span class="dropdown-icon">🖼️</span> Copy Embed
                                </button>
                            </li>
                            @if (!string.IsNullOrWhiteSpace(Model.ATProtoUri)) {
                                <li>
                                    <button class="dropdown-item copy-atproto-btn" type="button" data-uri="@Model.ATProtoUri">
                                        <span class="dropdown-icon">🔗</span> Copy ATProto URI
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
        <div class="embed-header">
            @if (!string.IsNullOrWhiteSpace(Model.PrimaryResult.ArtUrl)) {
                @if (!string.IsNullOrWhiteSpace(Model.CardUrl)) {
                    <a href="@Model.CardUrl" target="_blank" rel="noopener noreferrer">
                        <img src="@Model.PrimaryResult.ArtUrl" alt="@Model.PrimaryResult.Title artwork" class="embed-image" />
                    </a>
                } else {
                    <img src="@Model.PrimaryResult.ArtUrl" alt="@Model.PrimaryResult.Title artwork" class="embed-image" />
                }
            }
            <div class="embed-content">
                <div class="embed-info">
                    Artist: @(Model.PrimaryResult.Artist ?? "Unknown")
                    @if (!string.IsNullOrWhiteSpace(Model.PrimaryResult.ExternalId)) {
                        var idType = Model.PrimaryResult.IsAlbum == true ? "UPC" : "ISRC";
                        <text><br /></text>@idType<text>: </text>@Model.PrimaryResult.ExternalId
                    }
                </div>
            </div>
        </div>
        <div class="embed-providers">
            @foreach (var providerResult in Model.Result.Results) {
                <a href="@(ViewSecurityHelpers.IsHttpOrHttps(providerResult.Value.URL) ? providerResult.Value.URL : "#")" target="_blank" rel="noopener noreferrer" class="provider-button">
                    <span class="provider-icon provider-icon-@providerResult.Key.ToString().ToLowerInvariant()">
                        @providerResult.Key.GetProviderLogo( )
                    </span>
                    <span class="visually-hidden">@providerResult.Key.GetDescription()</span>
                </a>
            }
        </div>
        @if (Model.IsLookupInProgress || Model.Result.Messages is { Count: > 0 }) {
            <div class="alert alert-warning embed-partial-notice mb-0 mt-2" role="status">
                @if (Model.IsLookupInProgress) {
                    <strong>Still looking up…</strong>
                }
                @if (Model.Result.Messages is { Count: > 0 }) {
                    foreach (var message in Model.Result.Messages) {
                        <div>@message</div>
                    }
                }
            </div>
        }
    </div>
</div>
